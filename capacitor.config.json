{
  "appId": "com.retrocanopy.shibuyabotpit",
  "appName": "Shibuya Bot Pit",
  "webDir": ".",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://retrocanopy.com/shibuya_bot_pit.html?app=1",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": true,
      "backgroundColor": "#07080c",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#07080c"
    }
  }
}
